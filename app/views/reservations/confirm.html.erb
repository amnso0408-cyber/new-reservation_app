<h2>予約内容の確認</h2>

<p>チェックイン<%= @reservation.checkin_at %></p>
<p>チェックアウト<%= @reservation.checkout_at %></p>
<p>人数<%= @reservation.guest_count %>人</p>
<p>日数：<%= (@reservation.checkout_at - @reservation.checkin_at).to_i %>泊</p>
<p>お支払い金額　¥<%= ((@reservation.checkout_at - @reservation.checkin_at).to_i * @reservation.room.price * @reservation.guest_count).to_i %></p>
<p>上記内容で正しければ「確定」ボタンを押してください。</p>

<%= form_with model: @reservation, url: reservations_path, method: :post do |form| %>
  <%= form.hidden_field :room_id %>
  <%= form.hidden_field :checkin_at %>
  <%= form.hidden_field :checkout_at %>
  <%= form.hidden_field :guest_count %>
  <%= form.submit "確定" %>
<% end %>

<%= link_to "キャンセル", room_path(@room) %>
