<h2>施設詳細</h2>

<% if @reservation.errors.any?%>
  <ul>
    <% @reservation.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<div class="room-detail">
  <div class="room-detail-image">
  <% if @room.image.attached? %>
    <%= image_tag @room.image %>
  <% else %>
    <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png" %>
  <% end %>
  </div>

  <div class="room-detail-info">
    <p><%= @room.name %></p>
    <p><%= @room.address %></p>
    <p><%= @room.description %></p>
    <p>¥<%= @room.price %></p>
  </div>
</div>

  <%= form_with model: @reservation, url: reservations_confirm_path, method: :post, data: { turbo: false } do |form| %>
  <%= form.label :checkin_at, "チェックイン" %>
  <%= form.date_field :checkin_at %>
  <%= form.label :checkout_at, "チェックアウト" %>
  <%= form.date_field :checkout_at %>
  <%= form.label :guest_count, "人数" %>
  <%= form.number_field :guest_count %>
  <%= form.hidden_field :room_id, value: @room.id %>

  <%= form.submit "予約する" %>
  <% end %>
  <%= link_to "戻る", rooms_path %>