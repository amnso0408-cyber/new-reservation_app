<h2>施設一覧</h2>

<%= form_with url: rooms_path, method: :get do |f| %>
  <%= f.text_field :area, placeholder: "エリア名を入力" %>
  <%= f.text_field :keyword, placeholder: "キーワード名を入力" %>
  <%= f.submit "検索" %>
<% end %>

 <p>検索結果：<%= @rooms.count %>件</p>

<div class="room-list">
  <% @rooms.each do |room| %>
    <div class="room-card">
      <% if room.image.attached? %>
        <%= image_tag room.image, class:"room-image"%>
      <% else %>
        <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", class:"room-image" %>
      <% end %>

      <p><%= link_to room.name, room_path(room) %></p>
      <p><%= room.address %></p>
      <p><%= room.description %></p>
      <p>¥<%= room.price %></p>
      <%= link_to "詳細", room_path(room) %>
    </div>
  <% end %>
</div>
