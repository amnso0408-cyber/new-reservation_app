<h2>登録済み一覧</h2>

<table>
  <tr>
    <th>画像</th>
    <th>施設名</th>
    <th>紹介文</th>
    <th>料金</th>
    <th>作成日</th>
  </tr>

  <% @rooms.each do |room| %>
    <tr>
      <td>
        <% if room.image.attached? %>
          <%= image_tag room.image, class: "room-image" %>
        <% else %>
          <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", class: "room-image" %>
        <% end %>
      </td>

      <td><%= room.name %></td>
      <td><%= room.description %></td>
      <td>¥<%= room.price %></td>
      <td><%= room.created_at.in_time_zone("Tokyo").strftime("%Y/%m/%d %H:%M") %></td>
      <td><%= link_to "編集", edit_room_path(room) %></td>
      <td><%= link_to "施設を削除", room_path(room), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %></td>
    </tr>
  <% end %>
</table>