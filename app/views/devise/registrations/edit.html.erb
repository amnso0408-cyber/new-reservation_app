<h2>編集画面</h2>

<%= form_with model: current_user, url: user_registration_path, method: :patch do |form| %>

  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "変更後パスワード" %>
    <%= form.password_field :password %>
  </div>

  <span>※変更する場合のみ</span>

  <div>
    <%= form.label :password_confirmation, "確認用パスワード" %>
    <%= form.password_field :password_confirmation %>
  </div>

  <span>※変更する場合のみ</span>

  <div>
    <%= form.label :current_password, "現在のパスワード" %>
    <%= form.password_field :current_password %>
  </div>

  <%= link_to "キャンセル", users_profile_path %>
  <%= form.submit "保存" %>

<% end %>