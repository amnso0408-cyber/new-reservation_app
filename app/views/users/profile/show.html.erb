<h2>プロフィール</h2>

<%= link_to "編集", users_profile_edit_path %>

<p>アイコン</p>
<% if current_user.icon.attached? %>
  <%= image_tag current_user.icon, width: 100, height: 100 %>
<% else %>
  <%= image_tag "https://rails-02-sample.herokuapp.com/assets/common/default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png" %>
<% end %>

<p>名前</p>
<p><%= current_user.name %></p>

<p>自己紹介</p>
<p><%= current_user.introduction %></p>

<%= link_to "アカウント設定", users_account_path %>
<%= link_to "プロフィール設定", users_profile_path %>
