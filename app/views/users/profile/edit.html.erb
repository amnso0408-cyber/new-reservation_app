<h2>プロフィール</h2>

<%= form_with model: current_user, url: users_profile_path, method: :patch do |form| %>

  <div>
    <%= form.label :icon, "アイコン画像" %>
    <% if current_user.icon.attached? %>
      <%= image_tag current_user.icon %>
    <% else %>
      <%= image_tag "https://rails-02-sample.herokuapp.com/assets/common/default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png" %>
    <% end %>
  </div>

  <div>
    <%= form.label :name, "名前" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :introduction, "自己紹介" %>
    <%= form.text_area :introduction %>
  </div>

  <%= link_to "キャンセル", users_profile_path %>
  <%= form.submit "保存" %>

<% end %>